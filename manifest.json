{
   "action": {
      "default_popup": "popup.html",
      "default_title": "Twitch VOD Unmute — Modded"
   },
   "background": {
      "service_worker": "background.js"
   },
   "description": "Возвращает звук в заглушённых участках записей Twitch: откат по качеству, статистика и подсветка на полосе прокрутки.",
   "host_permissions": [ "https://*.twitch.tv/*", "https://twitch.tv/*", "https://*.ttvnw.net/*", "https://*.cloudfront.net/*" ],
   "icons": {
      "128": "128.png",
      "16": "16.png",
      "48": "48.png"
   },
   "manifest_version": 3,
   "minimum_chrome_version": "102",
   "name": "Twitch VOD Unmute — Modded",
   "permissions": [ "declarativeNetRequest", "webRequest", "storage", "scripting", "tabs" ],
   "version": "1.8.0"
}
